DATABASE_URL=postgresql://a3:a3_local_dev@localhost:5432/a3
PORT=3001

# ---- 账号系统（以下全部可选）----
# 邮箱验证码：配置 SMTP 后，注册与绑定邮箱需要 6 位验证码；不配置则直接用邮箱 + 密码注册。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=noreply@example.com
# SMTP_PASS=
# SMTP_FROM=山水尖3 <noreply@example.com>

# 微信扫码登录（微信开放平台「网站应用」）。三项都填才启用真实扫码；
# WECHAT_REDIRECT_BASE 必须是开放平台登记的授权回调域名（可用 hosts / 内网穿透指到本机）。
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_BASE=https://a3.example.com
# 未配置时默认提供「本机模拟扫码」便于联调；设为 0 可关闭。
# A3_WECHAT_MOCK=0

# 小程序 wx.login 登录。与网站应用绑定在同一开放平台账号下时，按 unionid 归并为同一账号。
# WECHAT_MINI_APP_ID=
# WECHAT_MINI_APP_SECRET=
