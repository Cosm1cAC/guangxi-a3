DATABASE_URL=postgresql://a3:a3_local_dev@localhost:5432/a3
PORT=3001
# 在线人数显示的服务器配置容量（需按部署与压测结果调整）。
A3_SERVER_CAPACITY=20

# ---- 账号系统（以下全部可选）----
# 邮箱验证码为可选；配置 SMTP 后可在注册或资料页验证，未验证仍可注册、登录和游戏。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=noreply@example.com
# SMTP_PASS=
# SMTP_FROM=山水尖3 <noreply@example.com>

# 微信扫码登录（微信开放平台「网站应用」）。三项都填才启用真实扫码；
# WECHAT_REDIRECT_BASE 填完整 HTTPS origin；开放平台的「授权回调域」填对应域名，不带协议与路径。
# 固定入口可用 https://a3.vibelink.cloud，回调路径是 /api/auth/wechat/callback。
# 必须使用已审核网站应用的凭据，小程序 / 公众号 AppID 不能替代。Secret 只放本机 .env。
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_BASE=https://a3.example.com
# 未配置时默认提供「本机模拟扫码」便于联调；设为 0 可关闭。
# A3_WECHAT_MOCK=0

# 小程序 wx.login 登录。与网站应用绑定在同一开放平台账号下时，按 unionid 归并为同一账号。
# WECHAT_MINI_APP_ID=
# WECHAT_MINI_APP_SECRET=
