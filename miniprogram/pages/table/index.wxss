page{background:#173f48;color:#edf0df;font-family:sans-serif}.page{padding:0 24rpx 28rpx}.heading{display:flex;justify-content:space-between;align-items:center;padding:24rpx 10rpx;border-bottom:1rpx solid #507270;font-size:22rpx}.brand{font-family:serif;font-size:38rpx;letter-spacing:6rpx}.welcome{display:flex;flex-direction:column;gap:18rpx;padding:34rpx 10rpx 0;color:#b5cec4;font-size:23rpx}.eyebrow{color:#d3b37b;letter-spacing:5rpx;font-size:20rpx}.title{font-family:serif;font-size:48rpx;color:#eef0df}.table-wrap{height:650rpx;position:relative;margin:0 -24rpx}.canvas{width:100%;height:100%}.emblem{position:absolute;top:48%;width:100%;text-align:center;font-family:serif;font-size:42rpx;letter-spacing:10rpx;color:#d3b37b}.player{position:absolute;background:#20464e;padding:12rpx;border:2rpx solid #4e7774;border-radius:14rpx;display:flex;flex-direction:column;gap:8rpx;font-size:24rpx;min-width:160rpx}.small{font-size:17rpx;color:#b1c8be}.active{border-color:#d3b37b}.seat-0{bottom:16rpx;left:calc(50% - 92rpx)}.seat-1{right:16rpx;top:28%}.seat-2{top:12rpx;left:calc(50% - 92rpx)}.seat-3{left:16rpx;top:28%}.trick{position:absolute;top:50%;width:100%;display:flex;justify-content:center;gap:8rpx}.mini-card{background:#eeedde;color:#253e46;padding:16rpx 12rpx;border-radius:6rpx;font-size:28rpx}.message{text-align:center;color:#dfc78c;font-size:23rpx;min-height:32rpx}.room{text-align:center;font-size:22rpx;padding:12rpx;color:#b9d5cb}.hand-heading{display:flex;justify-content:space-between;font-size:21rpx;color:#b2c6bb;padding:28rpx 4rpx}.hand{display:flex;justify-content:center;height:205rpx;padding:20rpx 60rpx 0 0}.card{flex:0 0 86rpx;width:86rpx;height:155rpx;margin-right:-40rpx;padding:12rpx;box-sizing:border-box;border:2rpx solid #bfc3b2;border-radius:10rpx;background:#f0eee0;color:#233c43;box-shadow:-4rpx 4rpx 10rpx #13313c;display:flex;flex-direction:column;font-family:serif;font-size:34rpx}.red{color:#b34c49}.selected{transform:translateY(-24rpx);background:#fff3cb;border-color:#d3b37b}.actions,.start-actions{display:flex;gap:18rpx;margin:20rpx 0}button{font-size:25rpx;color:#e2eadb;background:#29545a;border:1rpx solid #5d8179;border-radius:12rpx;flex:1;line-height:2.5}button::after{border:0}.primary{background:#d3b37b;color:#233c43}button[disabled]{opacity:.4;color:#c4d2c8;background:#29545a}.footer{text-align:center;font-size:19rpx;color:#99b6ae;padding:22rpx}.rules,.network,.results{background:#234b53;border:1rpx solid #537870;border-radius:16rpx;padding:28rpx;margin-top:25rpx}.rules text{display:block;line-height:1.9;font-size:24rpx;margin-bottom:16rpx}.result-title{font-size:32rpx!important;font-family:serif;color:#d3b37b}.results view{display:flex;justify-content:space-between;font-size:22rpx;padding:18rpx 0;border-bottom:1rpx solid #54736c}.network input{padding:20rpx;background:#173d46;margin:20rpx 0;font-size:26rpx}.error{color:#f4b6a7;font-size:24rpx;padding:14rpx}
.who{display:flex;align-items:center;gap:12rpx}.face{width:48rpx;height:48rpx;display:flex;flex-direction:column;flex:none;border:3rpx solid #10282e}.face.big{width:80rpx;height:80rpx}.face-row{flex:1}.account{display:flex;justify-content:space-between;align-items:center;font-size:24rpx;padding:10rpx 0 20rpx}
.hand{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:10rpx;height:auto;padding:20rpx 0;justify-content:initial}.card{width:auto;min-width:0;height:134rpx;margin:0;padding:8rpx;font-size:30rpx}.selected{transform:translateY(-10rpx)}.identity-card{border:3rpx solid #d3b37b}.identity-note{text-align:center;color:#ffe0a0;background:#234b53;padding:12rpx;margin:8rpx 0;font-size:24rpx}
