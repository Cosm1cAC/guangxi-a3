@import "../../fonts/pixel.wxss";
page{background:#17232e;color:#ecf0df;font-family:"Block A3 Pixel",monospace,sans-serif}.page{padding:0 24rpx 32rpx;padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}.heading{display:flex;justify-content:space-between;align-items:center;gap:16rpx;padding:24rpx 0;border-bottom:4rpx solid #3c4c55}.brand{font-size:38rpx;font-weight:900;letter-spacing:4rpx;text-shadow:3rpx 3rpx #080f17}.rules-toggle{font-size:22rpx;padding:16rpx 10rpx;color:#badb94}.welcome{display:flex;flex-direction:column;gap:18rpx;padding:32rpx 0 0;font-size:23rpx;color:#b6c5bd}.eyebrow{font-size:20rpx;color:#badb94;letter-spacing:4rpx}.title{font-size:44rpx;font-weight:900;color:#f0f0dd;line-height:1.4}.table-wrap{height:610rpx;position:relative;margin:0 -24rpx}.canvas{width:100%;height:100%}.emblem{position:absolute;top:47%;width:100%;text-align:center;font-size:42rpx;letter-spacing:8rpx;font-weight:900;color:#c4d4a5;text-shadow:3rpx 3rpx #102d24;pointer-events:none}.player{position:absolute;background:#202f39;padding:12rpx;border:4rpx solid #52646a;box-shadow:4rpx 4rpx #0b151d;display:flex;flex-direction:column;gap:8rpx;font-size:22rpx;min-width:146rpx;max-width:205rpx;box-sizing:border-box}.small{font-size:18rpx;color:#bdccc1}.active{border-color:#badb94;background:#2b443c}.seat-0{bottom:12rpx;left:50%;transform:translateX(-50%)}.seat-1{right:16rpx;top:23%}.seat-2{top:12rpx;left:50%;transform:translateX(-50%)}.seat-3{left:16rpx;top:23%}.trick{position:absolute;top:56%;width:100%;display:flex;flex-wrap:wrap;justify-content:center;gap:6rpx;padding:0 36rpx;box-sizing:border-box}.mini-card{background:#f0f0dd;color:#17232e;padding:12rpx 8rpx;border:3rpx solid #a8b3a0;box-shadow:3rpx 3rpx #10231e;font-size:25rpx;font-weight:700}.message{text-align:center;color:#d8e9ab;font-size:23rpx;line-height:1.6;min-height:32rpx}.table-message{position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);box-sizing:border-box;width:max-content;max-width:88%;padding:10rpx 18rpx;border:3rpx solid #789565;background:#172c28;z-index:2;pointer-events:none}.room{text-align:center;font-size:22rpx;padding:16rpx;color:#b6d695}.hand-heading{display:flex;justify-content:space-between;gap:14rpx;flex-wrap:wrap;font-size:21rpx;color:#bdccc1;padding:24rpx 0 12rpx}.hand{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:10rpx;padding:20rpx 0 12rpx}.card{min-width:0;height:134rpx;box-sizing:border-box;padding:8rpx;border:3rpx solid #b3baa7;border-top-color:#fffef0;border-left-color:#fffef0;background:#f0f0dd;color:#17232e;box-shadow:3rpx 3rpx #080f17;display:flex;flex-direction:column;justify-content:space-between;font-size:30rpx;font-weight:900}.card-suit{align-self:flex-end}.red{color:#b63f42}.selected{transform:translateY(-10rpx);background:#e2efbb;border:4rpx solid #96cc68;box-shadow:0 6rpx #41633c}.identity-card{outline:3rpx solid #d0b36c;outline-offset:-7rpx}.identity-note{color:#f1e1ad;background:#303a34;border-left:6rpx solid #d0b36c;padding:14rpx 16rpx;margin:10rpx 0;font-size:23rpx;line-height:1.6}.note-label{color:#bdcc95;font-size:19rpx;margin-right:16rpx}.actions,.start-actions{display:flex;gap:16rpx;margin:22rpx 0}button{margin:0;box-sizing:border-box;padding:6rpx 10rpx;font-family:inherit;font-size:25rpx;font-weight:700;color:#e2eadb;background:#344650;border:4rpx solid #61737a;border-top-color:#849297;border-left-color:#849297;border-bottom-color:#14212a;border-right-color:#14212a;border-radius:0;flex:1;line-height:2.6;box-shadow:0 4rpx #0b131b}button::after{border:0}.primary{background:#abd082;color:#192a20;border-top-color:#d9edb3;border-left-color:#d9edb3;border-bottom-color:#587747;border-right-color:#587747}.button-pressed{transform:translateY(3rpx);box-shadow:none}button[disabled]{color:#839087;background:#293841;border-color:#405058;box-shadow:none}.footer{text-align:center;line-height:1.8;font-size:19rpx;color:#92a69e;padding:24rpx 4rpx}.rules,.network,.results{background:#202f39;border:4rpx solid #485b62;padding:24rpx;margin-top:24rpx;box-shadow:5rpx 5rpx #0d1820}.rules text{display:block;line-height:1.95;font-size:24rpx;margin-bottom:18rpx}.result-title{display:block;font-size:30rpx!important;font-weight:900;color:#c4dea4}.results>view{display:flex;justify-content:space-between;gap:12rpx;font-size:22rpx;padding:18rpx 0;border-bottom:2rpx solid #485b62}.network input{box-sizing:border-box;width:100%;height:86rpx;padding:18rpx;background:#14212a;border:3rpx solid #485b62;margin:20rpx 0;font-size:26rpx;color:#f0f0dd}.network>button{margin:16rpx 0}.error{color:#f4b6a7;font-size:24rpx;padding:16rpx}.who{display:flex;align-items:center;gap:12rpx;min-width:0}.who>text{overflow-wrap:anywhere}.face{width:48rpx;height:48rpx;display:flex;flex-direction:column;flex:none;border:3rpx solid #101b23;image-rendering:pixelated}.face.big{width:80rpx;height:80rpx}.face-row{flex:1}.account{display:flex;gap:16rpx;justify-content:space-between;align-items:center;font-size:24rpx;padding:10rpx 0 20rpx}

.choice-panel{padding:24rpx;background:#202f39;border:4rpx solid #789565;margin:20rpx 0}.choice-panel>text{display:block;font-size:24rpx;line-height:1.7;margin:10rpx 0}.choice-pool{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin:20rpx 0}.pool-card{display:flex;flex-direction:column;background:#f0f0dd;color:#17232e;padding:12rpx;font-size:28rpx;line-height:1.7;border:4rpx solid #adb99e}.pool-card text+text{font-size:20rpx}.pool-card.picked{background:#e2efbb;border-color:#d7df75}.pool-card.conflict{outline:4rpx solid #ed897a}.pool-card[disabled]{opacity:.7;color:#17232e;background:#d0d6c4}.choice-result{color:#d8e9ab}

.music-toggle{width:100%;margin:20rpx 0}.music-panel{padding:24rpx;border:4rpx solid #789565;background:#202f39;margin:20rpx 0}.music-panel>text{display:block;line-height:1.8;font-size:23rpx;color:#c9d7bc}.music-panel .music-title{font-size:30rpx;color:#e7dda8;font-weight:bold}.music-times{display:flex;justify-content:space-between;font-size:20rpx;color:#b5c5b5}.music-mode{font-size:24rpx;background:#14221d;padding:18rpx}.music-tracks{display:grid;gap:10rpx;margin:20rpx 0}.music-tracks button{text-align:left;padding:14rpx 18rpx;line-height:1.7}.music-tracks text{display:block;font-size:24rpx}.music-tracks text+text{font-size:19rpx;color:#b6c9a9}.music-tracks .current{border-color:#c0d99b;background:#34472e}.music-panel .music-credit{font-size:19rpx}

.pixel-suit{width:32rpx;height:39rpx;display:flex;flex-direction:column}.pixel-suit>view,.pixel-hand>view{flex:1}.rps-window{padding:24rpx;background:#c6c6c6;color:#263126;border:6rpx solid #151a18;box-shadow:inset 6rpx 6rpx #fff,inset -6rpx -6rpx #646b5e;margin:18rpx 0}.rps-window>text{display:block;text-align:center;line-height:1.7;font-size:23rpx}.rps-window .rps-title{font-size:32rpx;font-weight:bold}.rps-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin:24rpx 0}.rps-options .rps-slot{padding:12rpx 4rpx;display:flex;flex-direction:column;align-items:center;color:#263126;background:#8b8b8b;border:5rpx solid #444b3e;border-right-color:#f0f0e8;border-bottom-color:#f0f0e8;line-height:1.7}.rps-slot.chosen{outline:5rpx solid #587e3e;background:#b4ca91}.pixel-hand{width:112rpx;height:112rpx;display:flex;flex-direction:column}.rps-confirm{background:#98bb70;color:#24351f}.teammate-panel{margin:20rpx 0;padding:20rpx;background:#202f39;border:4rpx solid #789565}.teammate-panel text{font-size:24rpx;line-height:1.7}.observed-hand{display:flex;flex-wrap:wrap;gap:10rpx;margin:14rpx 0}.observed-card{padding:12rpx;background:#f0f0dd;color:#17232e;border:3rpx solid #a8b3a0;display:flex;flex-direction:column;gap:6rpx}.observed-card.red{color:#b63f42}

.room-waiting{padding:24rpx;margin:16rpx 0;background:#303d34;border:4rpx solid #778565;color:#dce8cd}.room-waiting button{margin-top:20rpx}.room-note{display:block;color:#a8b59a;font-size:22rpx;margin:16rpx 0}
